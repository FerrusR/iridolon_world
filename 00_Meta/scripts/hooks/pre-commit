#!/bin/sh
# pre-commit — проверка frontmatter в волте перед коммитом.
#   1) lint_frontmatter.py --check  — механика YAML (кавычки у ссылок), по всему волту.
#   2) check_schema.py   --staged   — обязательные поля (arcs / место у NPC), только для
#                                     staged .md (легаси-пробелы в незатронутых файлах не мешают).
# Обход разово:  git commit --no-verify
#
# Каноничная копия — в 00_Meta/scripts/hooks/ (версионируется). Переустановить:
#   cp 00_Meta/scripts/hooks/pre-commit .git/hooks/ && chmod +x .git/hooks/pre-commit

VAULT="$(git rev-parse --show-toplevel)"
LINT="$VAULT/00_Meta/scripts/lint_frontmatter.py"
SCHEMA="$VAULT/00_Meta/scripts/check_schema.py"

if ! command -v python3 >/dev/null 2>&1; then
  echo "⚠️  pre-commit: python3 не найден — проверки frontmatter пропущены."
  exit 0
fi

fail=0

# 1) YAML-механика (весь волт)
if [ -f "$LINT" ]; then
  python3 "$LINT" "$VAULT" --check
  s=$?
  if [ "$s" = "2" ]; then
    echo "⚠️  pre-commit: нужен pyyaml —  pip install pyyaml --break-system-packages"
    echo "    (проверки frontmatter пропущены)"
    exit 0
  fi
  [ "$s" != "0" ] && fail=1
fi

# 2) Схема обязательных полей (только staged-файлы)
if [ -f "$SCHEMA" ]; then
  python3 "$SCHEMA" --staged
  s=$?
  [ "$s" != "0" ] && [ "$s" != "2" ] && fail=1
fi

if [ "$fail" != "0" ]; then
  echo ""
  echo "⛔ Коммит остановлен: проблемы во frontmatter (см. выше)."
  echo "   YAML-механика:      python3 \"00_Meta/scripts/lint_frontmatter.py\" . --fix"
  echo "   Схема (arcs/место): заполни поля  или  python3 \"00_Meta/scripts/check_schema.py\" . --fix"
  echo "   Пропустить разово:  git commit --no-verify"
  exit 1
fi

exit 0
