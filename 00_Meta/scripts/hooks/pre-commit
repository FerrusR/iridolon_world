#!/bin/sh
# pre-commit — не даёт закоммитить битый YAML-фронтматтер (properties) в волте.
# Ставится в .git/hooks/pre-commit. Обход разово:  git commit --no-verify
#
# Каноничная копия лежит в 00_Meta/scripts/hooks/ (версионируется).
# Переустановить после клонирования волта:
#   ln -sf ../../00_Meta/scripts/hooks/pre-commit .git/hooks/pre-commit
#   (или)  cp 00_Meta/scripts/hooks/pre-commit .git/hooks/ && chmod +x .git/hooks/pre-commit

VAULT="$(git rev-parse --show-toplevel)"
SCRIPT="$VAULT/00_Meta/scripts/lint_frontmatter.py"

# Нет скрипта — не мешаем коммиту.
[ -f "$SCRIPT" ] || exit 0

# Нет python3 — предупреждаем, но не блокируем.
if ! command -v python3 >/dev/null 2>&1; then
  echo "⚠️  pre-commit: python3 не найден — проверка фронтматтера пропущена."
  exit 0
fi

python3 "$SCRIPT" "$VAULT" --check
status=$?

# Код 2 = не установлен pyyaml. Не блокируем, только подсказываем.
if [ "$status" = "2" ]; then
  echo "⚠️  pre-commit: нужен pyyaml —  pip install pyyaml --break-system-packages"
  echo "    (проверка фронтматтера пропущена)"
  exit 0
fi

if [ "$status" != "0" ]; then
  echo ""
  echo "⛔ Коммит остановлен: в свойствах есть проблемы (см. выше)."
  echo "   Починить:   python3 \"00_Meta/scripts/lint_frontmatter.py\" . --fix"
  echo "   Затем:      git add -u   и повторить коммит"
  echo "   Пропустить: git commit --no-verify"
  exit 1
fi

exit 0
